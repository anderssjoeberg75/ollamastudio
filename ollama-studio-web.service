[Unit]
# systemd-tjänst för Ollama Studio Web.
# Installera:
#   sudo cp ollama-studio-web.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/ollama-studio-web.service   (justera sökväg/port/token)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ollama-studio-web
# Status/loggar:
#   systemctl status ollama-studio-web
#   journalctl -u ollama-studio-web -f
Description=Ollama Studio Web (webb-GUI för Ollama-modeller)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ollamastudio
ExecStart=/usr/bin/python3 /opt/ollamastudio/ollama_web.py
Restart=on-failure
RestartSec=3

# --- Inställningar (ändra efter behov) ---
Environment=OLLAMA_STUDIO_HOST=0.0.0.0
Environment=OLLAMA_STUDIO_PORT=8080
Environment=OLLAMA_URL=http://localhost:11434
# Rekommenderas starkt på ett nätverk – kräver ett lösenord för att hantera modeller:
# Environment=OLLAMA_STUDIO_TOKEN=byt-till-nagot-hemligt
# Kör du en Ollama-instans per GPU (se ollama-gpu@.service)? Lista dem här som
# "label,url,gpu ; label,url,gpu" så får du en GPU-väljare i chatten.
# OBS: citattecken runt HELA raden krävs eftersom värdet innehåller mellanslag.
# Environment="OLLAMA_STUDIO_BACKENDS=GPU 0,http://127.0.0.1:11434,0 ; GPU 1,http://127.0.0.1:11435,1"

# Kör gärna som en egen användare i stället för root om du vill:
# User=ollama

[Install]
WantedBy=multi-user.target
